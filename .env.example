# Copy to .env only when you need to change something: the site runs without it.

# The address the site is served from, without a trailing slash. The canonical
# link, the language alternates and the social sharing image are built from it.
# Set it to your real domain before you deploy. It is read at build time, so run
# `yarn build` again after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3030
